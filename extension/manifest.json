{
  "manifest_version": 3,
  "name": "FollowClean Assist",
  "version": "0.3.0",
  "description": "Enriquece a fila do FollowClean enquanto você revisa perfis no Instagram.",
  "permissions": ["storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://followclean.netlify.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://followclean.netlify.app/*"],
      "js": ["followclean-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["instagram-profile.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "FollowClean Assist",
    "default_popup": "popup.html"
  }
}
